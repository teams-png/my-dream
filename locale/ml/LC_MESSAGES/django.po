msgid "Type the 6-digit code shown in the app:"
msgstr "ആപ്പിൽ കാണുന്ന 6 അക്ക കോഡ് ടൈപ്പ് ചെയ്യുക:"

#: templates/webapp/security.html
msgid "Turn on"
msgstr "ഓൺ ചെയ്യുക"

#: templates/webapp/security.html
msgid ""
"Even if someone learns your password, they cannot sign in without your "
"phone. Strongly recommended for owners and admins."
msgstr ""
"ആരെങ്കിലും പാസ്‌വേഡ് അറിഞ്ഞാലും നിങ്ങളുടെ ഫോൺ ഇല്ലാതെ ലോഗിൻ ചെയ്യാൻ "
"കഴിയില്ല. ഉടമകൾക്കും അഡ്മിൻമാർക്കും നിർബന്ധമായും ശുപാർശ ചെയ്യുന്നു."

#: templates/webapp/security.html
msgid "Set up two-step login"
msgstr "ടു-സ്റ്റെപ്പ് ലോഗിൻ സെറ്റ് ചെയ്യുക"

#: templates/webapp/security.html
msgid "Forgot it? Use “Forgot password” on the sign-in page."
msgstr "മറന്നോ? ലോഗിൻ പേജിലെ “പാസ്‌വേഡ് മറന്നോ” ഉപയോഗിക്കുക."

#: templates/webapp/security.html
msgid "Reset password by email"
msgstr "ഇമെയിൽ വഴി പാസ്‌വേഡ് റീസെറ്റ്"

