msgid "Number of guests"
msgstr "விருந்தினர்களின் எண்ணிக்கை"

#: apps/webapp/online_booking_views.py
msgid "Email (optional)"
msgstr "மின்னஞ்சல் (விருப்பம்)"

#: apps/webapp/online_booking_views.py
msgid "Notes (optional)"
msgstr "குறிப்புகள் (விருப்பம்)"

#: apps/webapp/online_booking_views.py
msgid "Type of event"
msgstr "நிகழ்வு வகை"

#: apps/webapp/online_booking_views.py
msgid "Wedding, birthday, corporate…"
msgstr "திருமணம், பிறந்தநாள், நிறுவன நிகழ்வு…"

#: apps/webapp/online_booking_views.py
msgid "Send booking request"
msgstr "முன்பதிவு கோரிக்கையை அனுப்பு"

#: apps/webapp/online_booking_views.py
msgid "Thank you! We received your request."
msgstr "நன்றி! உங்கள் கோரிக்கை கிடைத்தது."

#: apps/webapp/online_booking_views.py
msgid "We will confirm on WhatsApp or by phone shortly."
msgstr "விரைவில் WhatsApp அல்லது தொலைபேசியில் உறுதிப்படுத்துவோம்."

#: apps/webapp/online_booking_views.py
msgid "Make another booking"
msgstr "மற்றொரு முன்பதிவு செய்"

#: apps/webapp/online_booking_views.py
msgid "Until (time)"
msgstr "வரை (நேரம்)"

#: apps/webapp/online_booking_views.py
msgid "Too many requests from this connection. Please call or WhatsApp us."
msgstr ""
"இந்த இணைப்பிலிருந்து அதிகமான கோரிக்கைகள். எங்களை அழைக்கவும் அல்லது WhatsApp "
"செய்யவும்."

#: apps/webapp/online_booking_views.py
msgid "Online booking isn't available for this business type."
msgstr "இந்த வணிக வகைக்கு ஆன்லைன் முன்பதிவு கிடைக்கவில்லை."

#: apps/webapp/online_booking_views.py
msgid "Your BookPilot team sets up your website for you."
msgstr "உங்கள் BookPilot குழு உங்கள் இணையதளத்தை அமைக்கும்."

#: apps/webapp/online_booking_views.py
msgid "Only the business owner can open this page."
msgstr "வணிக உரிமையாளர் மட்டுமே இந்தப் பக்கத்தைத் திறக்க முடியும்."

#: apps/webapp/online_booking_views.py
msgid "Booking confirmed. Send the confirmation on WhatsApp."
msgstr ""
"முன்பதிவு உறுதிசெய்யப்பட்டது. WhatsApp-இல் உறுதிப்படுத்தலை அனுப்பவும்."

#: apps/webapp/online_booking_views.py
msgid "Choose the staff member and save to finish the appointment."
msgstr "சந்திப்பை முடிக்க ஊழியரைத் தேர்ந்தெடுத்து சேமிக்கவும்."

#: apps/webapp/online_booking_views.py
msgid "Request declined. Let the customer know on WhatsApp."
msgstr ""
"கோரிக்கை நிராகரிக்கப்பட்டது. வாடிக்கையாளருக்கு WhatsApp-இல் தெரிவிக்கவும்."

#: apps/webapp/online_booking_views.py
msgid "Online booking is on"
msgstr "ஆன்லைன் முன்பதிவு இயக்கத்தில் உள்ளது"

#: apps/webapp/online_booking_views.py
msgid "Note above the form"
msgstr "படிவத்தின் மேலே குறிப்பு"

#: apps/webapp/online_booking_views.py
msgid "Minimum notice (hours)"
msgstr "குறைந்தபட்ச முன்னறிவிப்பு (மணிநேரம்)"

#: apps/webapp/online_booking_views.py
msgid "How many days ahead people can book"
msgstr "எத்தனை நாட்கள் முன்னதாக முன்பதிவு செய்யலாம்"

#: apps/webapp/online_booking_views.py
msgid "Online booking settings saved."
msgstr "ஆன்லைன் முன்பதிவு அமைப்புகள் சேமிக்கப்பட்டன."

#: apps/webapp/online_booking_views.py
msgid "Appointment"
msgstr "சந்திப்பு"

#: apps/webapp/online_booking_views.py
msgid "Booking"
msgstr "முன்பதிவு"

#: apps/webapp/online_booking_views.py
msgid "Table reservation"
msgstr "மேசை முன்பதிவு"

#: apps/webapp/online_booking_views.py
msgid "Confirmed"
msgstr "உறுதிசெய்யப்பட்டது"

#: apps/webapp/online_booking_views.py
msgid "Declined"
msgstr "நிராகரிக்கப்பட்டது"

#: apps/webapp/online_booking_views.py
msgid "Enter your name and a phone / WhatsApp number."
msgstr "உங்கள் பெயரையும் தொலைபேசி / WhatsApp எண்ணையும் உள்ளிடவும்."

#: apps/webapp/online_booking_views.py
msgid "Choose a date."
msgstr "தேதியைத் தேர்ந்தெடுக்கவும்."

#: apps/webapp/online_booking_views.py
msgid "Choose a date from today onwards."
msgstr "இன்று முதல் ஒரு தேதியைத் தேர்ந்தெடுக்கவும்."

#: apps/webapp/online_booking_views.py
msgid "Choose a time."
msgstr "நேரத்தைத் தேர்ந்தெடுக்கவும்."

#: apps/webapp/online_booking_views.py
msgid "Choose what you want to book."
msgstr "எதை முன்பதிவு செய்ய விரும்புகிறீர்கள் எனத் தேர்ந்தெடுக்கவும்."

#: apps/webapp/online_booking_views.py
msgid "Choose the check-out / return date."
msgstr "செக்-அவுட் / திருப்பி அளிக்கும் தேதியைத் தேர்ந்தெடுக்கவும்."

#: apps/webapp/online_booking_views.py
msgid "The end date must be after the start date."
msgstr "முடிவுத் தேதி தொடக்கத் தேதிக்குப் பிறகு இருக்க வேண்டும்."

#: apps/webapp/online_booking_views.py
msgid "Online booking is not available."
msgstr "ஆன்லைன் முன்பதிவு கிடைக்கவில்லை."

#: apps/webapp/online_booking_views.py
msgid "Shown above the form, e.g. opening hours."
msgstr "படிவத்தின் மேலே காட்டப்படும், எ.கா. திறந்திருக்கும் நேரம்."

#: apps/webapp/online_order_views.py
msgid "Take orders from my website (cart)"
msgstr "என் இணையதளத்திலிருந்து ஆர்டர்களை எடு (கார்ட்)"

#: apps/webapp/online_order_views.py
msgid "Pause — not taking orders now"
msgstr "இடைநிறுத்து — இப்போது ஆர்டர்கள் இல்லை"

#: apps/webapp/online_order_views.py
msgid "Home delivery"
msgstr "வீட்டு டெலிவரி"

#: apps/webapp/online_order_views.py
msgid "Delivery charge"
msgstr "டெலிவரி கட்டணம்"

#: apps/webapp/online_order_views.py
msgid "Minimum order for delivery"
msgstr "டெலிவரிக்கான குறைந்தபட்ச ஆர்டர்"

#: apps/webapp/online_order_views.py
msgid "Send to kitchen without asking"
msgstr "கேட்காமல் சமையலறைக்கு அனுப்பு"

#: apps/webapp/online_order_views.py
msgid "Ready in (minutes)"
msgstr "தயாராகும் நேரம் (நிமிடங்கள்)"

#: apps/webapp/online_order_views.py
msgid "Note in the cart"
msgstr "கார்டில் குறிப்பு"

#: apps/webapp/online_order_views.py
msgid "Shows “+ Add” on every menu item of your website and a cart."
msgstr ""
"உங்கள் இணையதளத்தின் ஒவ்வொரு மெனு பொருளிலும் “+ சேர்” மற்றும் ஒரு கார்டைக் "
"காட்டும்."

#: apps/webapp/online_order_views.py
msgid ""
"Use when the kitchen is busy or closed. The menu stays; the cart says “not "
"taking orders now”."
msgstr ""
"சமையலறை பிஸியாக அல்லது மூடியிருக்கும்போது பயன்படுத்தவும். மெனு இருக்கும்; "
"கார்டில் “இப்போது ஆர்டர்கள் இல்லை” எனக் காட்டும்."

#: apps/webapp/online_order_views.py
msgid ""
"Off: you accept each order first. On: orders go straight to the kitchen."
msgstr ""
"முடக்கம்: ஒவ்வொரு ஆர்டரையும் முதலில் நீங்கள் ஏற்க வேண்டும். இயக்கம்: "
"ஆர்டர்கள் நேரடியாகச் சமையலறைக்குச் செல்லும்."

#: apps/webapp/online_order_views.py
msgid "0 = no minimum."
msgstr "0 = குறைந்தபட்சம் இல்லை."

#: apps/webapp/online_order_views.py
msgid "e.g. Delivery only inside Doha · Cash on delivery"
msgstr "எ.கா. தோஹாவுக்குள் மட்டும் டெலிவரி · டெலிவரியில் பணம்"

#: apps/webapp/online_order_views.py
msgid "Delivery only inside Doha · Cash on delivery"
msgstr "தோஹாவுக்குள் மட்டும் டெலிவரி · டெலிவரியில் பணம்"

#: apps/webapp/online_order_views.py
msgid "Choose pickup, delivery or both."
msgstr "பிக்அப், டெலிவரி அல்லது இரண்டையும் தேர்வுசெய்யவும்."

#: apps/webapp/online_order_views.py
msgid "Website ordering settings saved."
msgstr "இணையதள ஆர்டர் அமைப்புகள் சேமிக்கப்பட்டன."

#: apps/webapp/online_order_views.py
msgid "Order %(no)s accepted and sent to the kitchen."
msgstr "ஆர்டர் %(no)s ஏற்கப்பட்டு சமையலறைக்கு அனுப்பப்பட்டது."

#: apps/webapp/online_order_views.py
msgid "Order %(no)s rejected."
msgstr "ஆர்டர் %(no)s நிராகரிக்கப்பட்டது."

#: apps/webapp/pay_views.py
msgid "Payment received — thank you!"
msgstr "கட்டணம் பெறப்பட்டது — நன்றி!"

#: apps/webapp/pay_views.py
msgid "The payment was not completed. No money was taken."
msgstr "கட்டணம் முடிக்கப்படவில்லை. பணம் எடுக்கப்படவில்லை."

#: apps/webapp/pay_views.py
msgid "Your payment is being confirmed. Refresh this page in a minute."
msgstr ""
"உங்கள் கட்டணம் உறுதிப்படுத்தப்படுகிறது. ஒரு நிமிடத்தில் இந்தப் பக்கத்தைப் "
"புதுப்பிக்கவும்."

#: apps/webapp/pay_views.py
msgid ""
"Saved, but some keys are missing — the Pay now button stays hidden until "
"they are filled in."
msgstr ""
"சேமிக்கப்பட்டது, ஆனால் சில விசைகள் இல்லை — அவை நிரப்பப்படும் வரை “இப்போது "
"செலுத்து” பொத்தான் மறைந்திருக்கும்."

#: apps/webapp/pay_views.py
msgid "Payment settings saved."
msgstr "கட்டண அமைப்புகள் சேமிக்கப்பட்டன."

#: apps/webapp/property_views.py
msgid "Choose a tenant or type a new tenant's name."
msgstr ""
"குத்தகைதாரரைத் தேர்ந்தெடுக்கவும் அல்லது புதிய குத்தகைதாரர் பெயரை உள்ளிடவும்."

#: apps/webapp/property_views.py
msgid "New property"
msgstr "புதிய சொத்து"

#: apps/webapp/property_views.py
msgid "New unit"
msgstr "புதிய அலகு"

#: apps/webapp/property_views.py
msgid "Lease %(number)s created."
msgstr "குத்தகை %(number)s உருவாக்கப்பட்டது."

#: apps/webapp/property_views.py
msgid "Lease closed."
msgstr "குத்தகை மூடப்பட்டது."

#: apps/webapp/property_views.py
msgid "Rent billed."
msgstr "வாடகைக்கு பில் போடப்பட்டது."

#: apps/webapp/property_views.py
msgid "This month's rent is already billed."
msgstr "இந்த மாத வாடகைக்கு ஏற்கனவே பில் போடப்பட்டது."

#: apps/webapp/property_views.py
msgid "%(count)s rent invoices created for %(month)s."
msgstr "%(month)s க்கு %(count)s வாடகை விலைப்பட்டியல்கள் உருவாக்கப்பட்டன."

#: apps/webapp/purchase_docs_views.py
msgid "Choose a supplier or type a new supplier's name."
msgstr "சப்ளையரைத் தேர்ந்தெடுக்கவும் அல்லது புதிய சப்ளையர் பெயரை உள்ளிடவும்."

#: apps/webapp/purchase_docs_views.py
msgid "Purchase order %(number)s created."
msgstr "கொள்முதல் ஆணை %(number)s உருவாக்கப்பட்டது."

#: apps/webapp/purchase_docs_views.py
msgid "Purchase order cancelled."
msgstr "கொள்முதல் ஆணை ரத்து செய்யப்பட்டது."

#: apps/webapp/purchase_docs_views.py
msgid "Enter the quantity received."
msgstr "பெற்ற அளவை உள்ளிடவும்."

#: apps/webapp/purchase_docs_views.py
msgid "Goods receipt %(number)s saved. Stock updated."
msgstr "சரக்கு ரசீது %(number)s சேமிக்கப்பட்டது. இருப்பு புதுப்பிக்கப்பட்டது."

#: apps/webapp/purchase_docs_views.py
msgid "Supplier bill saved (%(total)s)."
msgstr "சப்ளையர் பில் சேமிக்கப்பட்டது (%(total)s)."

#: apps/webapp/purchase_docs_views.py
msgid "Nothing received is waiting for a bill."
msgstr "பில்லுக்காகக் காத்திருக்கும் பெறப்பட்ட சரக்கு எதுவும் இல்லை."

#: apps/webapp/purchase_docs_views.py
msgid "You can return at most %(qty)s of %(item)s."
msgstr "%(item)s இல் அதிகபட்சம் %(qty)s திருப்பி அளிக்கலாம்."

#: apps/webapp/purchase_docs_views.py
msgid "Enter the quantity to return."
msgstr "திருப்பி அளிக்கும் அளவை உள்ளிடவும்."

#: apps/webapp/purchase_docs_views.py
msgid "Return %(number)s saved. Stock reduced."
msgstr "திருப்பி அளிப்பு %(number)s சேமிக்கப்பட்டது. இருப்பு குறைந்தது."

#: apps/webapp/quick_sale_views.py
msgid "bills waiting to sync"
msgstr "ஒத்திசைவுக்குக் காத்திருக்கும் பில்கள்"

#: apps/webapp/quick_sale_views.py
msgid "offline bills synced"
msgstr "ஆஃப்லைன் பில்கள் ஒத்திசைக்கப்பட்டன"

#: apps/webapp/quick_sale_views.py
msgid "Saved on this device"
msgstr "இந்தச் சாதனத்தில் சேமிக்கப்பட்டது"

#: apps/webapp/quick_sale_views.py
msgid "Offline bill — invoice number comes after sync"
msgstr "ஆஃப்லைன் பில் — ஒத்திசைவுக்குப் பிறகு விலைப்பட்டியல் எண் வரும்"

#: apps/webapp/quick_sale_views.py
msgid "Quick"
msgstr "விரைவு"

#: apps/webapp/quick_sale_views.py
msgid "Saved"
msgstr "சேமிக்கப்பட்டது"

#: apps/webapp/quick_sale_views.py
msgid "Short"
msgstr "குறைவு"

#: apps/webapp/quick_sale_views.py
msgid "Type the item name and price."
