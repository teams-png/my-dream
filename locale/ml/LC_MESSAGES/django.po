#: templates/webapp/security.html
msgid "Turn off"
msgstr "ഓഫ് ചെയ്യുക"

#: templates/webapp/security.html
msgid "Install"
msgstr "ഇൻസ്റ്റാൾ"

#: templates/webapp/security.html
msgid "Google Authenticator"
msgstr "Google Authenticator"

#: templates/webapp/security.html
msgid ", Microsoft Authenticator or Authy on your phone."
msgstr ", Microsoft Authenticator അല്ലെങ്കിൽ Authy ഫോണിൽ ഇൻസ്റ്റാൾ ചെയ്യുക."

#: templates/webapp/security.html
msgid "Tap"
msgstr "ടാപ്പ് ചെയ്യുക"

#: templates/webapp/security.html
msgid "and scan this QR code."
msgstr "ഈ QR കോഡ് സ്കാൻ ചെയ്യുക."

#: templates/webapp/security.html
msgid "Can't scan? Enter this key:"
msgstr "സ്കാൻ ചെയ്യാൻ പറ്റുന്നില്ലേ? ഈ കീ നൽകുക:"

