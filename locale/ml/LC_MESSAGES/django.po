msgid "Rooms"
msgstr "മുറികൾ"

#: apps/modules/catalog.py
msgid "Reservation"
msgstr "റിസർവേഷൻ"

#: apps/modules/catalog.py
msgid "Rental"
msgstr "വാടക"

#: apps/modules/catalog.py
msgid "Halls"
msgstr "ഹാളുകൾ"

#: apps/modules/catalog.py
msgid "Event booking"
msgstr "ഇവന്റ് ബുക്കിംഗ്"

#: apps/modules/catalog.py
msgid "event"
msgstr "ഇവന്റ്"

#: apps/modules/catalog.py
