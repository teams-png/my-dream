#: apps/webapp/views.py
msgid "The payment was cancelled or declined — no charge was made."
msgstr "പേയ്മെന്റ് റദ്ദാക്കി അല്ലെങ്കിൽ നിരസിച്ചു — പണം ഈടാക്കിയിട്ടില്ല."

#: apps/webapp/views.py
msgid ""
"Your payment is being confirmed. This page will show it within a minute."
msgstr ""
"നിങ്ങളുടെ പേയ്മെന്റ് സ്ഥിരീകരിക്കുന്നു. ഒരു മിനിറ്റിനുള്ളിൽ ഇവിടെ കാണാം."

#: apps/webapp/website_kit_views.py
msgid "Send us a message"
msgstr "ഞങ്ങൾക്ക് ഒരു സന്ദേശം അയക്കൂ"

#: apps/webapp/website_kit_views.py
msgid "Subject"
msgstr "വിഷയം"

#: apps/webapp/website_kit_views.py
msgid "Thank you! We will get back to you soon."
msgstr "നന്ദി! ഞങ്ങൾ ഉടൻ ബന്ധപ്പെടും."

#: apps/webapp/website_kit_views.py
msgid "Could not send. Please try again."
msgstr "അയക്കാനായില്ല. വീണ്ടും ശ്രമിക്കുക."

#: apps/webapp/website_kit_views.py
msgid "Please enter your name and a phone number or email."
msgstr "നിങ്ങളുടെ പേരും ഫോൺ നമ്പറോ ഇമെയിലോ നൽകുക."

#: apps/webapp/website_kit_views.py
msgid "Order sent"
msgstr "ഓർഡർ അയച്ചു"

#: apps/webapp/website_kit_views.py
msgid "Your order is in the kitchen."
msgstr "നിങ്ങളുടെ ഓർഡർ കിച്ചണിലാണ്."

#: apps/webapp/website_kit_views.py
msgid "The restaurant will confirm your order shortly."
msgstr "റെസ്റ്റോറന്റ് ഉടൻ നിങ്ങളുടെ ഓർഡർ സ്ഥിരീകരിക്കും."

#: apps/webapp/website_kit_views.py
msgid "Usually ready in about %s minutes."
msgstr "സാധാരണ ഏകദേശം %s മിനിറ്റിൽ റെഡിയാകും."

#: apps/webapp/website_kit_views.py
msgid "Track my order"
msgstr "എന്റെ ഓർഡർ ട്രാക്ക് ചെയ്യുക"

#: apps/webapp/website_kit_views.py
msgid "Your cart is empty. Tap “+ Add” on the menu."
msgstr "നിങ്ങളുടെ കാർട്ട് ശൂന്യമാണ്. മെനുവിൽ “+ ചേർക്കുക” അമർത്തുക."

#: apps/webapp/website_kit_views.py
msgid "Pickup from the restaurant"
msgstr "റെസ്റ്റോറന്റിൽ നിന്ന് പിക്കപ്പ്"

#: apps/webapp/website_kit_views.py
msgid "Sorry, we are not taking online orders right now."
msgstr "ക്ഷമിക്കണം, ഇപ്പോൾ ഓൺലൈൻ ഓർഡറുകൾ എടുക്കുന്നില്ല."

#: apps/webapp/website_kit_views.py
msgid "Please call %s."
msgstr "ദയവായി %s-ൽ വിളിക്കൂ."

#: apps/webapp/website_kit_views.py
msgid "Minimum for delivery:"
msgstr "ഡെലിവറിക്കുള്ള മിനിമം:"

#: apps/webapp/website_kit_views.py
msgid "Phone / WhatsApp, e.g. +974 5555 1234"
msgstr "ഫോൺ / WhatsApp, ഉദാ: +974 5555 1234"

#: apps/webapp/website_kit_views.py
msgid "Delivery address (zone, street, building, flat)"
msgstr "ഡെലിവറി വിലാസം (സോൺ, സ്ട്രീറ്റ്, കെട്ടിടം, ഫ്ലാറ്റ്)"

#: apps/webapp/website_kit_views.py
msgid "Note, e.g. less spicy, no onion"
msgstr "കുറിപ്പ്, ഉദാ: എരിവ് കുറച്ച്, ഉള്ളി വേണ്ട"

#: apps/webapp/website_kit_views.py
msgid "Place order"
msgstr "ഓർഡർ ചെയ്യുക"

#: apps/webapp/website_kit_views.py
msgid "Please enter your name."
msgstr "നിങ്ങളുടെ പേര് നൽകുക."

#: apps/webapp/website_kit_views.py
msgid "Please enter your phone number."
msgstr "നിങ്ങളുടെ ഫോൺ നമ്പർ നൽകുക."

#: apps/webapp/website_kit_views.py
msgid "Please enter the delivery address."
msgstr "ഡെലിവറി വിലാസം നൽകുക."

#: apps/webapp/website_kit_views.py
msgid "Could not send the order. Please try again."
msgstr "ഓർഡർ അയക്കാനായില്ല. വീണ്ടും ശ്രമിക്കുക."

#: apps/webapp/website_kit_views.py
msgid "No connection. Please try again."
msgstr "കണക്ഷൻ ഇല്ല. വീണ്ടും ശ്രമിക്കുക."

#: apps/webapp/website_kit_views.py
msgid "Added:"
msgstr "ചേർത്തു:"

